# Copy to .env.local for development. All values are server-only — there are
# no NEXT_PUBLIC_* variables in v2 (the browser never talks to Supabase or
# Slack directly).

# Supabase Postgres (no auth, no RLS, no storage in v2)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Slack app — see docs/master-architecture.md §7 for the required scopes
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_REMINDER_CHANNEL_ID=

# App
APP_BASE_URL=http://localhost:3000

# Vercel Cron auth — generate with: openssl rand -hex 32
CRON_SECRET=
